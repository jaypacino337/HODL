{
  "name": "pumpbrokers",
  "private": true,
  "version": "0.1.0",
  "description": "PumpBrokers — 1,000 pixel brokers on Solana. Three independently deployable pieces: honorary mint, public mint, buyback.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:site",
    "build:site": "npm run build --workspace packages/pumpbrokers-site",
    "dev": "npm run dev --workspace packages/pumpbrokers-site",
    "test": "npm run test:unit && npm run check:programs",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "check:programs": "cargo check --workspace",
    "typecheck": "npm run typecheck --workspace packages/pumpbrokers-site",
    "verify": "node scripts/verify-deployment.ts",
    "launch": "node scripts/set-active.ts --active true",
    "rollback": "node scripts/set-active.ts --active false"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "next": "^14.2.5"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0"
  },
  "license": "MIT",
  "type": "module"
}
