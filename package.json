{
  "name": "overbid",
  "private": true,
  "version": "0.1.0",
  "description": "OVERBID — Trade where housing goes next. A real-estate prediction market: city-outcome shares collateralized in USDG, priced by an on-chain AMM, settled against housing price indexes. Built to deploy on Robinhood Chain.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:website": "npm run dev --workspace packages/website",
    "build:website": "npm run build --workspace packages/website",
    "start:oracle": "npm run start --workspace packages/oracle-worker"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0"
  },
  "license": "MIT"
}
