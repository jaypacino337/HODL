{
  "name": "hodl-or-no-hodl",
  "private": true,
  "version": "0.1.0",
  "description": "HODL OR NO HODL — the on-chain game show. pump.fun creator fees are claimed every 15 minutes into a pot; holders with 500K+ tokens pick a side, and the winning side splits the pot weighted by their bags.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:website": "npm run dev --workspace packages/website",
    "start:worker": "npm run start --workspace packages/game-worker"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0"
  },
  "license": "MIT"
}
