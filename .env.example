# ═══════════════════════════════════════════════════════════════════════
# HODL OR NO HODL — game-worker environment (Railway service variables)
# ═══════════════════════════════════════════════════════════════════════

# ── Network ─────────────────────────────────────────────────────────────
# Start on devnet; point at mainnet-beta (ideally a paid RPC like Helius)
# only after a full claim -> pick -> flip -> payout cycle works end to end.
RPC_URL=https://api.devnet.solana.com

# ── Token ───────────────────────────────────────────────────────────────
# The pump.fun coin's mint address.
MINT_ADDRESS=

# ── Game vault ──────────────────────────────────────────────────────────
# The wallet that CREATED the coin on pump.fun. It claims the creator fees
# (fee vaults are keyed by creator pubkey), holds the pot, and pays winners.
# Either a path to a Solana CLI JSON keypair file, or — for Railway — the
# raw JSON array itself: GAME_VAULT_KEYPAIR=[12,34,...]
GAME_VAULT_KEYPAIR=./keys/game-vault.json

# ── Game rules ──────────────────────────────────────────────────────────
# Round length / fee-claim interval in ms. 900000 = 15 minutes.
ROUND_INTERVAL_MS=900000
# Picks lock this long before the flip (anti-sniping buffer).
PICK_LOCK_BUFFER_MS=30000
# Minimum whole-token balance to play.
MIN_HOLD_TOKENS=500000
# Lamports always kept in the vault for tx fees (0.02 SOL).
VAULT_RESERVE_LAMPORTS=20000000
# Comma-separated wallets banned from playing/winning: LP pools, treasury,
# CEX hot wallets, etc. (The vault itself is always excluded automatically.)
EXCLUDED_OWNERS=

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL + the service_role key (Settings -> API). The service key
# stays on the server only — never expose it to the website.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── API ─────────────────────────────────────────────────────────────────
# Railway injects PORT automatically; API_PORT is the local fallback.
API_PORT=4000
# Lock this to your Vercel domain(s) in production, e.g.
# CORS_ORIGINS=https://www.hodlornohodl.fun
CORS_ORIGINS=*

# ── pump.fun ────────────────────────────────────────────────────────────
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
