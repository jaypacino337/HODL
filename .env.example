# ── OVERBID environment ───────────────────────────────────────────────────────
# The website needs NONE of these: it builds and runs in demo mode with zero
# config, so a plain Vercel import "just works". Everything below is for the
# oracle/settlement worker and (later) live contract deployments.

# ── Supabase (oracle worker ledger: index observations + settlements) ─────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # service role — server side only, never in the website

# ── Parcl Labs (US housing index data; https://docs.parcllabs.com/) ───────────
# v1 coverage is US-only. Non-US cities (e.g. Toronto) need a licensed local
# index provider and their own oracle adapter — see docs/ARCHITECTURE.md.
PARCL_LABS_API_KEY=

# ── Oracle worker ─────────────────────────────────────────────────────────────
PORT=4000
ORACLE_POLL_MINUTES=360                   # how often to pull fresh index values (minutes)
CORS_ORIGINS=*                            # lock to your Vercel domain in production

# ── Chain (Robinhood Chain when public; Arbitrum Sepolia as the stand-in) ─────
CHAIN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
CHAIN_ID=421614
USDG_TOKEN_ADDRESS=                       # USDG (Global Dollar) collateral token
MARKET_FACTORY_ADDRESS=
HOUSE_POOL_ADDRESS=
ORACLE_POSTER_PRIVATE_KEY=                # key allowed to post index values / settle (server only)

# ── Website (all optional — omit for demo mode) ───────────────────────────────
NEXT_PUBLIC_API_URL=                      # oracle worker URL, e.g. https://overbid-oracle.up.railway.app
NEXT_PUBLIC_CHAIN_ID=421614
