# ═══════════════════════════════════════════════════════════════════════
# ATTENTION MARKETS — engine environment (Railway service variables)
# ═══════════════════════════════════════════════════════════════════════

# ── Network ─────────────────────────────────────────────────────────────
# Start on devnet; move to mainnet (ideally a Helius/QuickNode RPC) only
# after a full claim -> split -> buyback -> payout cycle works end to end.
RPC_URL=https://api.devnet.solana.com

# ── Token ───────────────────────────────────────────────────────────────
# The ecosystem coin's mint address, and the cashtag shown/required in
# attention posts.
MINT_ADDRESS=
TICKER=$ATTN

# ── Wallets ─────────────────────────────────────────────────────────────
# The wallet that CREATED the coin on pump.fun. Claims the creator fees,
# holds every pool, signs buybacks and reward payouts. Either a path to a
# Solana CLI JSON keypair, or (for Railway) the raw array: [12,34,...]
TREASURY_KEYPAIR=./keys/treasury.json
# Receives the development share of ad/project revenue.
DEV_WALLET=

# ── The flywheel ────────────────────────────────────────────────────────
# Creator fees: 50% buybacks / 50% attention rewards.
FEE_BUYBACK_SHARE=0.5
# Project (ad) revenue: 90% buybacks / 10% development.
REVENUE_BUYBACK_SHARE=0.9
# Claim creator fees every 15 minutes.
CLAIM_INTERVAL_MS=900000
# Execute the accumulated buyback pool every 4 hours.
BUYBACK_INTERVAL_MS=14400000
# Attention-rewards epoch: 7 days, then the rewards pool pays out pro-rata
# by approved points and a new epoch opens.
EPOCH_LENGTH_MS=604800000
# Send bought tokens to the incinerator instead of holding them.
BURN_BUYBACKS=false
# Lamports always kept in the treasury for tx fees (0.05 SOL).
TREASURY_RESERVE_LAMPORTS=50000000

# ── Scanner ─────────────────────────────────────────────────────────────
# Run the attention scanner every hour. DexScreener + CoinGecko work with
# no keys; add keys below to light up the news / X columns.
SCAN_INTERVAL_MS=3600000
# newsapi.org key (optional) — enables the news source.
NEWS_API_KEY=
# X (Twitter) API v2 bearer token (optional) — enables automatic
# verification + engagement-weighted points for submitted posts.
X_BEARER_TOKEN=

# ── Ads ─────────────────────────────────────────────────────────────────
# Price per ad-slot day, in lamports (0.5 SOL).
AD_PRICE_LAMPORTS_PER_DAY=500000000

# ── Admin ───────────────────────────────────────────────────────────────
# Shared secret for the review endpoints (approving posts, rejecting ads).
# Generate something long and random.
ADMIN_KEY=

# ── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── API ─────────────────────────────────────────────────────────────────
API_PORT=4000
# Lock to your site's domain in production.
CORS_ORIGINS=*

# ── pump.fun ────────────────────────────────────────────────────────────
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
