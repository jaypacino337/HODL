# ── Network ──────────────────────────────────────────────────────────────
# Start on devnet. Only point this at mainnet-beta once you've tested a full
# harvest -> LP -> snapshot -> airdrop cycle end to end.
RPC_URL=https://api.devnet.solana.com

# ── Token ────────────────────────────────────────────────────────────────
# The $ARROW (or your renamed token) mint address.
MINT_ADDRESS=

# ── Wallets (all paths point to Solana CLI-style JSON keypair files) ─────
# Allowed to claim pump.fun creator-fee rewards / withdraw Token-2022
# withheld transfer fees. This MUST be the wallet that created the coin on
# pump.fun, since creator-fee vaults are keyed by creator pubkey.
FEE_AUTHORITY_KEYPAIR_PATH=./keys/fee-authority.json

# Receives the LP-bound share of harvested fees and signs Raydium
# add-liquidity transactions.
LP_VAULT_KEYPAIR_PATH=./keys/lp-vault.json

# Receives the holder-rewards share of harvested fees and pays out every
# 15-minute airdrop.
REWARDS_VAULT_KEYPAIR_PATH=./keys/rewards-vault.json

# ── Tokenomics parameters ──────────────────────────────────────────────────
# Fraction (0-1) of harvested fees routed to the LP vault; remainder funds
# holder rewards.
LP_SHARE=0.5

# How often to snapshot holders and airdrop, in milliseconds. 900000 = 15 min.
SNAPSHOT_INTERVAL_MS=900000

# Comma-separated wallet addresses to exclude from snapshots/airdrops
# (fee authority, LP vault, rewards vault, treasury, burn address, any CEX
# deposit wallets holding the token on behalf of many users, etc).
EXCLUDED_OWNERS=

# Minimum raw base-unit balance required to be airdrop-eligible (filters dust).
MIN_ELIGIBLE_BALANCE=1

# ── pump.fun / Raydium ──────────────────────────────────────────────────
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
# Set once the coin graduates to a Raydium/PumpSwap pool. Auto-LP no-ops until then.
RAYDIUM_POOL_ID=

# ── snapshot-bot service ───────────────────────────────────────────────
DB_PATH=./data/sherwood.sqlite
API_PORT=4000
