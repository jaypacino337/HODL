# ── THE BOARDROOM — engine environment (Railway service variables) ───────────
# The WEBSITE needs none of these: it builds and runs truthfully with zero
# config (PREVIEW). Launch state is derived from what is actually set here.

# ── AI (server-only; enables live sessions) ──────────────────────────────────
ANTHROPIC_API_KEY=
BOARD_MODEL=claude-opus-5

# ── Supabase (governance record) ─────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # service role — server-side only

# ── Ops ──────────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGINS=*                          # lock to your Vercel domain in prod
ADMIN_KEY=                              # long random string; guards admin API
SESSION_INTERVAL_MINUTES=1440           # automatic session cadence
ENGINE_PAUSED=false

# ── Chain (read-only treasury snapshots; REQUIRED for sessions) ──────────────
# Robinhood Chain when its public RPC ships; Arbitrum Sepolia until then.
CHAIN_RPC_URL=
CHAIN_ID=421614
TREASURY_ADDRESS=
USDG_TOKEN_ADDRESS=
BOARD_TOKEN_ADDRESS=
BOARD_VAULT_ADDRESS=
STOCK_TOKENS_JSON=[]                    # e.g. [{"symbol":"AAPLx","address":"0x..."}]
TOKEN_PRICES_JSON={}                    # e.g. {"ETH":2900,"AAPLx":231.5}
RESERVED_LIABILITIES_USD=0
RECENT_REVENUE_USD=0

# ── Guarded execution (enables EXECUTION_GUARDED; leave empty until audited) ─
TREASURY_EXECUTOR_ADDRESS=
KEEPER_PRIVATE_KEY=                     # server-only; move to KMS before real funds

# ── Holder governance (enables FULLY_ACTIVE once the snapshot system works) ──
HOLDER_SNAPSHOT_ENABLED=false
