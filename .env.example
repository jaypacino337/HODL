# ---------------------------------------------------------------------------
# PumpBrokers
#
# Copy to .env.local (site) or .env (scripts). Never commit the filled-in file.
# Anything without a NEXT_PUBLIC_ prefix stays server-side and is never inlined
# into the browser bundle.
# ---------------------------------------------------------------------------

# SERVER ONLY. No NEXT_PUBLIC_ prefix, deliberately — the browser reaches Helius
# through /api/rpc, which forwards a narrow allowlist of read methods.
HELIUS_API_KEY=

# devnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=devnet

# $PUMPBROKER SPL mint. Still unset — scripts refuse to touch mainnet without it.
NEXT_PUBLIC_PUMPBROKER_MINT=

# mpl-core collection, written by scripts/create-collection.ts.
NEXT_PUBLIC_COLLECTION_ADDRESS=

# Must end in a slash. The program builds ${base}${artIndex}.json
NEXT_PUBLIC_METADATA_BASE_URI=

# Shown on every asset between mint and reveal.
NEXT_PUBLIC_PLACEHOLDER_URI=
