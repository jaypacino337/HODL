# Website env (Vercel project variables). All NEXT_PUBLIC_* values are
# public by design — no secrets here.

# The Railway game-worker's public URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:4000

# RPC the browser uses to read wallet balances. Public mainnet RPC rate-limits
# hard — use a free Helius/QuickNode endpoint for production.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# The coin's mint address (shown in the footer, links to pump.fun).
NEXT_PUBLIC_MINT_ADDRESS=
