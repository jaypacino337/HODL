# Website env (Vercel project variables). All NEXT_PUBLIC_* values are
# public by design — no secrets here.

# The Railway engine's public URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:4000

# RPC the browser uses (wallet flows). Public mainnet RPC rate-limits —
# use a free Helius/QuickNode endpoint in production.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# The ecosystem coin's mint (status bar link to pump.fun).
NEXT_PUBLIC_MINT_ADDRESS=
