# Website env — ALL optional. With none of these set the site builds and runs
# truthfully in PREVIEW: protocol facts, mandates and policy only.

# Live engine (Railway) — enables live data, SSE stream and signed chat:
NEXT_PUBLIC_API_URL=

# Labeled local demonstration mode — renders the deterministic simulated
# session from @board/shared under a permanent "SIMULATED SESSION" banner.
# Never enable in production.
NEXT_PUBLIC_DEMO_MODE=false
